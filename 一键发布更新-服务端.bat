@echo off
chcp 65001 >nul
title HIOps 服务端 V2.1 一键极速发布与更新程序
color 0F

echo ==============================================================
echo        HIOps 服务端 V2.1 极速发布与在线升级程序
echo ==============================================================
echo.
echo 本工具将自动连接目标 Linux 服务器，一键完成以下任务：
echo   1. 上传并部署 V2.1 智能取证网关与业务感知因果分析引擎
echo   2. 自动清洗 PostgreSQL 数据库中历史遗留的伪根因与虚假置信度
echo   3. 调整系统服务与 Nginx 反向代理 (端口 5080/5082/5083)
echo   4. 平滑重载服务并验证在线 API 状态
echo.
echo 请选择目标服务器：
echo   [1] 生产基准服务器: 192.168.2.17 (默认)
echo   [2] 当前测试服务器: 192.168.114.30
echo   [3] 手动输入其他服务器 IP
echo.
set /p TARGET_OPT="请输入选项 [1/2/3, 回车默认 1]: "

set TARGET_IP=192.168.2.17
if "%TARGET_OPT%"=="2" set TARGET_IP=192.168.114.30
if "%TARGET_OPT%"=="3" (
    set /p TARGET_IP="请输入服务器 IP: "
)

echo.
echo --------------------------------------------------------------
echo 正在连接 %TARGET_IP% 并执行 V2.1 发布升级...
echo --------------------------------------------------------------

python "%~dp0deploy_forensic_svc.py" %TARGET_IP%

echo.
echo ==============================================================
echo 发布升级操作已执行完毕！
echo ==============================================================
pause
