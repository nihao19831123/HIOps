{
  "ConnectionStrings": {
    "PostgreSQL": "Host=127.0.0.1;Port=5432;Database=hiops;Username=hiops;Password=hiops"
  },
  "Jwt": {
    "Issuer": "HIOps.Api",
    "Key": "HIOpsDevKey-2026-ChangeMe-0123456789ABCDEF",
    "ExpireMinutes": 480
  },
  "Security": {
    "MasterKey": "HIOpsDevMasterKey-0123456789ABCDEF"
  },
  "Features": {
    "ShowRealOnly": false,
    "MockEnabled": false
  },
  "Zabbix": {
    "Enabled": true,
    "BaseUrl": "http://192.168.2.18/zabbix/api_jsonrpc.php",
    "User": "Admin",
    "Password": "zabbix",
    "PollSeconds": 20,
    "HostAssetMapping": {
      "Zabbix server": "ZBX-SRV-01"
    }
  },
  "ChangeDiscovery": {
    "Enabled": true,
    "IntervalSeconds": 900,
    "WindowHours": 24,
    "MinLostSeconds": 300,
    "DedupeToleranceSeconds": 120,
    "UptimeKey": "system.uptime"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dlp": {
    "ProbeWatch": {
      "Enabled": true,
      "OfflineMinutes": 5,
      "AlertCooldownMinutes": 60,
      "IntervalSeconds": 60,
      "ExpectedVersion": "2.0.1",
      "RebootCorrelationMinutes": 30,
      "ActiveWindowDays": 7,
"RebootLookbackDays": 7,
      "_说明": "ExpectedVersion=期望的探针版本,低于它进「未升级清单」;RebootCorrelationMinutes=重启后多久没心跳判「疑似未自启」;RebootLookbackDays=重启记录(ChangeLogs)回看天数。各键均可在 appsettings.Development.json / 环境变量覆盖。"
    }
  },
  "SemanticAdjudication": {
    "Mode": "Disabled",
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "qwen2.5-7b-instruct",
    "TimeoutSeconds": 30,
    "MaxCandidates": 3,
    "PromptVersion": "v1",
    "_说明": "Mode: Disabled(默认,不对外调用) / ExternalCloud(外网云模型) / IntranetPrivate(内网私有化端点,改这里即可指向院内服务,不改代码)。BaseUrl 为 OpenAI 兼容基址,如 http://127.0.0.1:5099/v1"
  },
  "NetworkObservation": {
    "Enabled": true,
    "IntervalSeconds": 900,
    "Segments": [ "192.168.2.", "192.168.10.", "192.168.20.", "192.168.30.", "192.168.31.", "192.168.40.", "192.168.50." ],
    "NewHostAlert": true,
    "NewHostCooldownMinutes": 1440,
    "MaxItems": 5000,
    "_说明": "网络侧发现:只读消费 Zabbix 已采到的交换机 ARP 表(ipNetToMediaTable),给出『当前在线终端 × 装没装探针』台账。Segments=关注的终端网段前缀(不配则用默认六段);『在线』= ARP 表项存活 ≈ 最近约 20 分钟内有通信,不是『此刻开机』。NewHostAlert=新 MAC 首次出现即写事件(NETWORK_NEW_HOST);NewHostCooldownMinutes=同 MAC 冷却(默认 1440 分钟);MaxItems=单轮入账上限(防一次拉爆)。本功能不写交换机、不写 Zabbix、不自动创建资产。"
  }
}
